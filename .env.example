# ── LLM ──────────────────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=           # alternative LLM backend

# ── Flight search ─────────────────────────────────────────────────────────────
SEARCH_API_KEY=               # searchapi.io — select the Amadeus engine

# ── Activities ────────────────────────────────────────────────────────────────
GOOGLE_PLACES_API_KEY=        # Google Cloud Console — enable Places API (New)
GOOGLE_KNOWLEDGE_API_KEY=     # optional, not currently used

# ── Storage (defaults shown) ──────────────────────────────────────────────────
SQLITE_DB_PATH=data/travel_agent.db
CHROMA_DB_PATH=data/chroma

# ── Cache TTLs (defaults shown) ───────────────────────────────────────────────
CACHE_TTL_HOURS=24
VOLATILE_CURRENCY_TTL_HOURS=6   # shorter TTL for NGN, TRY, ARS, ZWL

# ── Agent behaviour (defaults shown) ─────────────────────────────────────────
MAX_ELICITATION_TURNS=3

# ── LangSmith tracing (optional) ─────────────────────────────────────────────
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=group-travel-agent
