# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── LLMs ──────────────────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
OPENAI_API_KEY=
HUGGINGFACE_API_TOKEN=
OPENROUTER_API_KEY=           # alternative LLM backend

# ── Flight search (Amadeus) ───────────────────────────────────────────────────
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_HOSTNAME=test         # use 'production' when ready

# ── Search APIs ───────────────────────────────────────────────────────────────
SEARCH_API_KEY=               # searchapi.io — select the Amadeus engine
RAPID_API_KEY=                # RapidAPI key
x-rapidapi-key=               # RapidAPI key (alternate header)
TAVILY_API_KEY=               # Tavily search

# ── Activities ────────────────────────────────────────────────────────────────
GOOGLE_PLACES_API_KEY=        # Google Cloud Console — enable Places API (New)
GOOGLE_KNOWLEDGE_API_KEY=     # optional, not currently used

# ── Storage (defaults shown) ──────────────────────────────────────────────────
SQLITE_DB_PATH=data/travel_agent.db
CHROMA_DB_PATH=data/chroma

# ── Cache TTLs (defaults shown) ───────────────────────────────────────────────
CACHE_TTL_HOURS=24
VOLATILE_CURRENCY_TTL_HOURS=6   # shorter TTL for NGN, TRY, ARS, ZWL

# ── Agent behaviour (defaults shown) ─────────────────────────────────────────
DEFAULT_CURRENCY=USD
MAX_TRAVELLERS=5
MAX_CANDIDATE_DESTINATIONS=10
TOP_ACTIVITIES=3
ACTIVITIES_RADIUS_METRES=15000
MAX_ELICITATION_TURNS=2

# ── LangSmith tracing (optional) ─────────────────────────────────────────────
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=group-travel-agent
LANGCHAIN_ENDPOINT=https://eu.api.smith.langchain.com
